# Copia in .env.local (sviluppo, branch Neon "dev") o .env.collaudo.local (copia di collaudo, branch "collaudo").
# Solo le VITE_* finiscono nel bundle: sono pubbliche.
VITE_NEON_DATABASE_URL=https://<endpoint>.c-7.eu-central-1.aws.neon.tech/neondb
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.c-7.eu-central-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.c-7.eu-central-1.aws.neon.tech/neondb/rest/v1
# Solo per gli script in scripts/ (migration, import, collaudo). Mai nel frontend.
DATABASE_URL=postgresql://<ruolo>:<password>@<endpoint>-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require
